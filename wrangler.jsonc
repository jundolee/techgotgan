{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techgotgan",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "techgotgan"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "ab1478da05d74baea725848539b40d95"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://efwfmebvvnxumuvydbrq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_5J4u25Cz2lHGDOll0sW6mA_wc4H5lQL"
  }
}
