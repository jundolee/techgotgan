{
  "name": "techgotgan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cloudflare": "NEXT_PUBLIC_ANALYTICS_ENABLED=false NEXT_PUBLIC_GTM_ENABLED=false opennextjs-cloudflare build",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "NEXT_PUBLIC_ANALYTICS_ENABLED=false NEXT_PUBLIC_GTM_ENABLED=true opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cloudflare:direct": "NEXT_PUBLIC_ANALYTICS_ENABLED=false NEXT_PUBLIC_GTM_ENABLED=true opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true wrangler deploy --config wrangler.jsonc",
    "smoke:cloudflare": "node scripts/smoke-cloudflare-preview.mjs",
    "lint": "eslint",
    "test": "tsx --conditions react-server --test tests/*.test.ts tests/*.test.mjs",
    "intoss:dev": "npm --prefix apps/in-toss run dev",
    "intoss:build": "npm --prefix apps/in-toss run build",
    "intoss:deploy": "npm --prefix apps/in-toss run deploy",
    "cron:ingest": "tsx --conditions react-server scripts/run-ingestion-sweep.ts",
    "cron:summaries": "tsx --conditions react-server scripts/run-summary-worker.ts",
    "cron:embeddings": "tsx --conditions react-server scripts/run-embedding-worker.ts",
    "diagnose:ingestion-sources": "tsx --conditions react-server scripts/inspect-ingestion-sources.ts",
    "repair:d2-source": "tsx --conditions react-server scripts/repair-d2-source.ts",
    "cleanup:orphan-thumbnails": "tsx --conditions react-server scripts/cleanup-orphan-thumbnails.ts",
    "backfill:categories": "npx tsx scripts/backfill-categories.ts",
    "retry:summaries": "npx tsx --conditions react-server scripts/retry-summaries.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.5",
    "@karrotmarket/react-monochrome-icon": "^1.25.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@next/third-parties": "^16.2.12",
    "@pinecone-database/pinecone": "^9.0.0",
    "@seed-design/css": "^2.2.1",
    "@seed-design/react": "^2.0.4",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.9",
    "cheerio": "^1.2.0",
    "next": "^16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261118.1": true
  }
}
