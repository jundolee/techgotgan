# Set these after connecting the existing Supabase project and deploying
# supabase/functions/techgotgan-intoss-api.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>

# For local development against the Next.js API instead, set this URL and leave
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY empty.
# VITE_TECHGOTGAN_API_URL=http://localhost:3000
